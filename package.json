{
  "name": "smart-expense-tracker",
  "version": "1.0.0",
  "description": "Smart Expense Tracker REST API",
  "main": "src/server.js",
  "scripts": {
    "prestart": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src -e ts,json --exec ts-node src/server.ts",
    "build": "tsc && npm run build --prefix client",
    "test": "jest"
  },
  "keywords": [
    "expense-tracker",
    "express",
    "api",
    "rest",
    "diligent"
  ],
  "author": "Jeevan M",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
